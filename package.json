{
  "name": "window-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Head-tracked window parallax hero for landing pages: a three.js room behind your headline, with an off-axis projection driven by on-device face tracking.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "node scripts/preview.mjs",
    "test": "node --test test/unit.test.mjs && node test/smoke.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "measure": "node scripts/measure.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
